{
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "**/.ssh/*": "deny",
      "**/.aws/credentials": "deny"
    },
    "bash": {
      "*": "allow",
      "sudo *": "ask",
      "rm -rf /*": "deny",
      "rm -rf ~*": "deny",
      "* | sh": "deny",
      "* | bash": "deny",
      "curl * | *": "deny"
    },
    "external_directory": "allow"
  }
}
