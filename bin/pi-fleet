#!/usr/bin/env bash
# pi-fleet — quick reference for the Pi agent-seat profiles.
set -euo pipefail

bold=$'\033[1m'; dim=$'\033[2m'; cyan=$'\033[36m'; reset=$'\033[0m'

cat <<EOF
${bold}pi-fleet${reset} ${dim}— reusable Pi agent seats (outfitter profile + tool-enforcing wrapper)${reset}

${bold}PROFILES${reset}  ${dim}(run the command; cd to your target dir first)${reset}
  ${cyan}pi-implementer${reset}          GPT-5.6 Sol · rw+bash    Build a ticket in a worktree (code+tests→PR)
  ${cyan}pi-reviewer${reset}             GPT-5.5 · read-only     Independent review/QC (different model than build)
  ${cyan}pi-ac-verifier${reset}          GPT-5.5 · bash          RUN the AC verification (tests/build); check boxes on pass
  ${cyan}pi-researcher${reset}           GPT-5.5 · read-only     Read-only scouting / investigation
  ${cyan}pi-designer${reset}             GPT-5.6 Terra · rw+bash  Design / architecture / API + planning docs
  ${cyan}claude-designer${reset}         Claude Code · design MCP Read/update claude.ai designs + implement (claude_design)
  ${cyan}pi-planner${reset}              GPT-5.6 Terra · bash     Feature → Linear project + issues breakdown
  ${cyan}pi-security-reviewer${reset}    GPT-5.6 Sol · read-only Security-focused review (severity + file:line)
  ${cyan}pi-conductor${reset}            GPT-5.5 · rw+bash        Cross-project router → assigns project leads
  ${cyan}pi-project-lead${reset}         GPT-5.5 · rw+bash        Project lead: cast workers + model (classifier), gates
  ${cyan}pi-visual-qa${reset}            GPT-5.6 Terra · bash    Capture app screenshot + compare to the comp
  ${cyan}pi-linear${reset}               GPT-5.5 · bash+linear   Full Linear issue/project management
  ${cyan}pi-personal-assistant${reset}   GPT-5.6 Terra · full     Personal social/X + comms/notes/tasks
                                             ${dim}(finch·gog·imsg·wacli·obsidian-cli·ntn·linear; draft→approve→execute)${reset}

${bold}EXTERNAL-HARNESS SEATS${reset}  ${dim}(not pi — no pi- prefix; cast into panes, monitored the same way)${reset}
  ${cyan}claude-reviewer${reset}         Claude Code · read-only   Independent review on a different harness
  ${cyan}claude-worker${reset}           Claude Code · rw+bash     Generic build worker (harness diversity)
  ${dim}agy-* disabled by roster lock; use claude-* or pi-* seats with openai-codex instead.${reset}

${bold}USAGE${reset}
  cd ~/some/project && pi-<role>              start a seat in that directory
  pi-<role> --provider openai-codex --model X override the model for this run
  PI_MODEL=gpt-5.5 pi-<role>                  env default (CLI flags still win)
  pi-<role> -p "do this thing"                one-shot, non-interactive
  outfitter profile list                      list profiles from outfitter directly

${bold}INSTALLED WRAPPERS${reset}
$(for f in "$(dirname "$0")"/pi-*; do [ -x "$f" ] && printf '  %s\n' "$(basename "$f")"; done)

${dim}Docs: ~/code/pi-fleet/README.md · an open-source pi agent-fleet toolkit${reset}
EOF
