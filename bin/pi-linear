#!/usr/bin/env bash
# Hybrid: outfitter composes skill/model/prompt/extensions; this wrapper hardcodes --tools (the boundary).
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$DIR/lib/peek-env.sh"
. "$DIR/lib/pi-model-env.sh"
PI_MODEL_ARGS="$(pi_model_override_args linear "" "$@")"
# shellcheck disable=SC2086
exec outfitter run --profile linear --agent pi -- $PI_MODEL_ARGS --tools read,grep,find,ls,bash,linear_get_issue,linear_list,linear_comment,linear_update "$@"
