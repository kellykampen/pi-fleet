#!/usr/bin/env bash
# Hybrid: outfitter composes skill/model/prompt/extensions; this wrapper hardcodes --tools (the boundary).
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$DIR/lib/pi-model-env.sh"
pi_model_override_args linear "" "$@"
exec outfitter run --profile linear --agent pi -- "${PI_MODEL_ARGS[@]+"${PI_MODEL_ARGS[@]}"}" --approve --tools read,grep,find,ls,bash,linear_get_issue,linear_list,linear_comment,linear_update "$@"
