#!/usr/bin/env bash
# Hybrid: outfitter composes skills/extensions/prompt/model; this wrapper hardcodes the
# --tools allowlist (outfitter's pi adapter can't set it). Enforcement lives here.
set -euo pipefail
exec outfitter run --profile linear --agent pi -- --tools read,grep,find,ls,linear_get_issue,linear_list,linear_comment,linear_update "$@"
