#!/usr/bin/env bash
# Hybrid: outfitter composes skill/model/prompt/extensions; this wrapper hardcodes --tools (the boundary).
# spike-breakdown reads Linear + the repo and creates a Linear project/issues via linear-cli (bash).
# Like pi-planner it has NO write/edit — it never touches repo source, only Linear.
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$DIR/lib/pi-model-env.sh"
PI_MODEL_ARGS="$(pi_model_override_args spike-breakdown "spike" "$@")"
# shellcheck disable=SC2086
exec outfitter run --profile spike-breakdown --agent pi -- $PI_MODEL_ARGS --approve --tools read,grep,find,ls,bash,linear_get_issue,linear_list,linear_comment,linear_update,context7_resolve-library-id,context7_query-docs "$@"
