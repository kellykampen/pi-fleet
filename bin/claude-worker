#!/usr/bin/env bash
# claude-worker — generic build worker on the Claude harness (harness diversity vs pi seats).
# Bash scoped to git/package-manager; can Edit/Write to implement.
set -euo pipefail
DIR="$HOME/code/pi-fleet"
. "$DIR/bin/lib/peek-env.sh"
# YOLO: autonomous fleets set FLEET_YOLO=1 to auto-approve (no permission prompts).
# Default (unset) is safe/interactive. Read-only seats stay read-only either way.
YOLO=""; [ "${FLEET_YOLO:-}" = "1" ] && YOLO="--dangerously-skip-permissions"
exec claude $YOLO \
  --allowedTools "Read Grep Glob Edit Write Bash(git:*) Bash(pnpm:*) Bash(npm:*) Bash(npx:*) Bash(node:*)" \
  --disallowedTools "Bash(rm -rf:*) Bash(sudo:*) Bash(curl:*)" \
  --append-system-prompt "$(cat "$DIR/skills/claude-worker/PROMPT.md")" \
  "$@"
