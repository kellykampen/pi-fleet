#!/usr/bin/env bash
# pi-fleet-eval-peekenv — deterministic smoke test for the PEEK_* launcher-env contract (PEK-64):
# bin/lib/peek-env.sh (workers), bin/lib/peek-lead-env.sh (project lead), and
# bin/lib/peek-conductor-env.sh (conductor). Proves parent preservation and PEEK_* defaulting
# purely via env/sourcing checks in throwaway subshells — no agent launch, no
# outfitter/pi/claude/agy dependency, so it's fast and safe to re-run anywhere.
set -uo pipefail
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(cd "$SELF_DIR/.." && pwd)"
WORKER_LIB="$REPO/bin/lib/peek-env.sh"
LEAD_LIB="$REPO/bin/lib/peek-lead-env.sh"
CONDUCTOR_LIB="$REPO/bin/lib/peek-conductor-env.sh"
OUT="${1:-$REPO/evals/results/peek-env-latest.txt}"
exec > >(tee "$OUT") 2>&1

pass=0; fail=0
check() {
  local desc="$1" got="$2" want_desc="$3" ok="$4"
  if [ "$ok" = 1 ]; then pass=$((pass + 1)); echo "PASS: $desc (got: $got)"
  else fail=$((fail + 1)); echo "FAIL: $desc (got: $got; want: $want_desc)"; fi
}
# Runs the given lib in a fully clean subshell env, only the given PEEK_*/CMUX_* vars set.
peek_source() {
  local lib="$1"; shift
  env -i HOME="$HOME" PATH="$PATH" "$@" bash -c ". '$lib'; echo \"ID=\$PEEK_ID ROLE=\$PEEK_ROLE PARENT=\$PEEK_PARENT WS=\$PEEK_WORKSPACE\""
}
peek_env() { peek_source "$WORKER_LIB" "$@"; }
peek_lead() { peek_source "$LEAD_LIB" "$@"; }
peek_conductor() { peek_source "$CONDUCTOR_LIB" "$@"; }
field() { echo "$1" | grep -oE "$2=[^ ]*" | cut -d= -f2-; }

echo "peek-env eval (bin/lib/peek-env.sh, peek-lead-env.sh, peek-conductor-env.sh)"

## --- worker (bin/lib/peek-env.sh) ---

# 1. Clean env: no PEEK_*, no CMUX_WORKSPACE_ID -> fresh worker identity, empty parent/workspace.
out=$(peek_env)
id=$(field "$out" ID); role=$(field "$out" ROLE); parent=$(field "$out" PARENT); ws=$(field "$out" WS)
[ -n "$id" ] && [ "$role" = worker ] && [ -z "$parent" ] && [ -z "$ws" ] && ok=1 || ok=0
check "clean env mints a worker identity with no parent/workspace" "$out" "ID=<nonempty> ROLE=worker PARENT= WS=" "$ok"

# 2. Minted worker PEEK_ID carries the promised 'worker-' prefix (not just any non-empty string).
echo "$id" | grep -qE '^worker-' && ok=1 || ok=0
check "worker PEEK_ID has the 'worker-' prefix" "ID=$id" "ID=worker-*" "$ok"

# 3. Inherited PEEK_ID (no PEEK_PARENT set) is captured as PEEK_PARENT BEFORE a fresh PEEK_ID is minted.
out=$(peek_env PEEK_ID=lead-abc123)
id=$(field "$out" ID); parent=$(field "$out" PARENT)
[ "$parent" = lead-abc123 ] && [ -n "$id" ] && [ "$id" != lead-abc123 ] && ok=1 || ok=0
check "inherited PEEK_ID preserved as PEEK_PARENT, own PEEK_ID freshly minted" "$out" "PARENT=lead-abc123 ID=<new, != lead-abc123>" "$ok"

# 4. PEEK_ORCH_ID is the fallback parent source when neither PEEK_ID nor PEEK_PARENT is set.
out=$(peek_env PEEK_ORCH_ID=orch-xyz)
parent=$(field "$out" PARENT)
[ "$parent" = orch-xyz ] && ok=1 || ok=0
check "PEEK_ORCH_ID used as parent fallback" "$out" "PARENT=orch-xyz" "$ok"

# 5. Explicit PEEK_PARENT (the cast-forwarding case: PEEK_PARENT="$PEEK_ID" on the cmux send
#    command) is trusted as-is; PEEK_ID is still freshly minted for the new worker.
out=$(peek_env PEEK_PARENT=lead-999)
id=$(field "$out" ID); parent=$(field "$out" PARENT)
[ "$parent" = lead-999 ] && [ -n "$id" ] && ok=1 || ok=0
check "explicit PEEK_PARENT (cast forwarding) trusted, PEEK_ID minted" "$out" "PARENT=lead-999 ID=<nonempty>" "$ok"

# 6. Both PEEK_ID and PEEK_PARENT pre-set (re-attach / manual override) -> both left untouched.
out=$(peek_env PEEK_ID=worker-fixed-1 PEEK_PARENT=lead-999)
[ "$out" = "ID=worker-fixed-1 ROLE=worker PARENT=lead-999 WS=" ] && ok=1 || ok=0
check "pre-set PEEK_ID + PEEK_PARENT (re-attach) left untouched" "$out" "ID=worker-fixed-1 PARENT=lead-999" "$ok"

# 7. Pre-set PEEK_ROLE is not clobbered with 'worker' (e.g. an orchestrator sourcing by mistake).
out=$(peek_env PEEK_ROLE=orchestrator)
role=$(field "$out" ROLE)
[ "$role" = orchestrator ] && ok=1 || ok=0
check "pre-set PEEK_ROLE is not overridden" "$out" "ROLE=orchestrator" "$ok"

# 8. PEEK_WORKSPACE falls back to CMUX_WORKSPACE_ID when unset.
out=$(peek_env CMUX_WORKSPACE_ID=ws-42)
ws=$(field "$out" WS)
[ "$ws" = ws-42 ] && ok=1 || ok=0
check "PEEK_WORKSPACE falls back to CMUX_WORKSPACE_ID" "$out" "WS=ws-42" "$ok"

# 9. Explicit PEEK_WORKSPACE wins over CMUX_WORKSPACE_ID.
out=$(peek_env PEEK_WORKSPACE=ws-explicit CMUX_WORKSPACE_ID=ws-42)
ws=$(field "$out" WS)
[ "$ws" = ws-explicit ] && ok=1 || ok=0
check "explicit PEEK_WORKSPACE wins over CMUX_WORKSPACE_ID" "$out" "WS=ws-explicit" "$ok"

# 10. Two sibling workers cast from the same parent mint distinct PEEK_IDs (no collisions).
idA=$(field "$(peek_env PEEK_ID=lead-shared)" ID)
idB=$(field "$(peek_env PEEK_ID=lead-shared)" ID)
[ -n "$idA" ] && [ -n "$idB" ] && [ "$idA" != "$idB" ] && ok=1 || ok=0
check "sibling workers cast from the same parent mint distinct PEEK_IDs" "$idA vs $idB" "distinct nonempty ids" "$ok"

# 11. Degradation case: a cast command that forwards an EMPTY PEEK_PARENT (e.g. because the
#     casting lead never had its own $PEEK_ID set) must not crash the worker — it degrades to a
#     parentless registration rather than erroring. This is the exact failure QC flagged against
#     PR #12 before pi-project-lead/pi-conductor established their own identity below.
out=$(peek_env PEEK_PARENT=)
id=$(field "$out" ID); parent=$(field "$out" PARENT)
[ -n "$id" ] && [ -z "$parent" ] && ok=1 || ok=0
check "empty forwarded PEEK_PARENT degrades to parentless (no crash)" "$out" "ID=<nonempty> PARENT=" "$ok"

## --- project lead (bin/lib/peek-lead-env.sh) ---

# 12. Clean env: lead mints its own orchestrator identity (role never 'worker'), no parent/workspace.
out=$(peek_lead)
id=$(field "$out" ID); role=$(field "$out" ROLE); parent=$(field "$out" PARENT)
[ -n "$id" ] && echo "$id" | grep -qE '^lead-' && [ "$role" = orchestrator ] && [ -z "$parent" ] && ok=1 || ok=0
check "project lead mints its own orchestrator identity ('lead-' prefix)" "$out" "ID=lead-* ROLE=orchestrator PARENT=" "$ok"

# 13. Lead's PEEK_WORKSPACE also falls back to CMUX_WORKSPACE_ID (one lead owns one cmux workspace).
out=$(peek_lead CMUX_WORKSPACE_ID=ws-proj1)
ws=$(field "$out" WS); role=$(field "$out" ROLE)
[ "$ws" = ws-proj1 ] && [ "$role" = orchestrator ] && ok=1 || ok=0
check "project lead PEEK_WORKSPACE falls back to CMUX_WORKSPACE_ID, role stays orchestrator" "$out" "WS=ws-proj1 ROLE=orchestrator" "$ok"

## --- conductor (bin/lib/peek-conductor-env.sh) ---

# 14. Clean env: conductor gets the fixed id/role peek's own docs specify (cwd-agnostic root).
out=$(peek_conductor)
[ "$out" = "ID=conductor ROLE=conductor PARENT= WS=" ] && ok=1 || ok=0
check "conductor gets fixed ID=conductor ROLE=conductor" "$out" "ID=conductor ROLE=conductor" "$ok"

# 15. Pre-set PEEK_ID is preserved (peek's docs: "unique is fine") rather than forced to 'conductor'.
out=$(peek_conductor PEEK_ID=conductor-2)
id=$(field "$out" ID)
[ "$id" = conductor-2 ] && ok=1 || ok=0
check "conductor pre-set PEEK_ID is preserved, not forced" "$out" "ID=conductor-2" "$ok"

## --- the full cast chain: lead identity -> forwarded PEEK_PARENT -> worker registration ---

# 16. End-to-end regression for the QC finding against PR #12: the lead establishes a real
#     PEEK_ID, forwards it as PEEK_PARENT into a FRESH subshell (simulating a new cmux pane that
#     does not inherit the lead's process env), and the worker must register under that exact id
#     — not empty.
lead_out=$(peek_lead CMUX_WORKSPACE_ID=ws-proj1)
lead_id=$(field "$lead_out" ID)
worker_out=$(env -i HOME="$HOME" PATH="$PATH" PEEK_PARENT="$lead_id" bash -c ". '$WORKER_LIB'; echo \"ID=\$PEEK_ID ROLE=\$PEEK_ROLE PARENT=\$PEEK_PARENT\"")
worker_parent=$(field "$worker_out" PARENT)
[ -n "$lead_id" ] && [ "$worker_parent" = "$lead_id" ] && ok=1 || ok=0
check "full cast chain: worker registers under the lead's real PEEK_ID as parent" "lead=$lead_id -> worker $worker_out" "worker PARENT=$lead_id" "$ok"

echo "  pass=$pass fail=$fail"
if [ "$fail" -eq 0 ]; then echo "  VERDICT: PASS"; else echo "  VERDICT: FAIL"; fi
[ "$fail" -eq 0 ]
