#!/usr/bin/env bash
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$DIR/lib/peek-env.sh"
. "$DIR/lib/pi-model-env.sh"
pi_model_override_args remotion "" "$@"
YOLO=""
[ "${FLEET_YOLO:-}" = "1" ] && YOLO="--approve"
exec outfitter run --profile remotion --agent pi -- "${PI_MODEL_ARGS[@]+"${PI_MODEL_ARGS[@]}"}" $YOLO --tools read,grep,find,ls,write,edit,bash "$@"
