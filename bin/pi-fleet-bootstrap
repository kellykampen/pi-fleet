#!/usr/bin/env bash
# pi-fleet-bootstrap — wire the pi-fleet repo into ~/.pi so global pi discovers everything.
# Idempotent; safe to re-run. Run once per machine (and after cloning pi-fleet fresh).
set -euo pipefail
umask 077

REPO="${PI_FLEET_REPO_ROOT:-$HOME/code/pi-fleet}"
# shellcheck source=lib/runtime-state.sh
. "$REPO/bin/lib/runtime-state.sh"
pi_fleet_ensure_runtime_root
RUNTIME_ROOT="$(pi_fleet_runtime_root)"
AGENT_DIR="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}"

link() { # link <target> <linkpath>
  local target="$1" link="$2"
  mkdir -p "$(dirname "$link")"
  if [ -L "$link" ]; then rm "$link"; elif [ -e "$link" ]; then mv "$link" "$link.bak.$$"; fi
  ln -s "$target" "$link"
  echo "  ✓ $link -> $target"
}

echo "pi-fleet bootstrap:"
# MCP servers (context7/playwright/convex/claude_design)
link "$REPO/mcp.json" "$AGENT_DIR/mcp.json"
# Spawnable subagent roster (pi-subagents discovers ~/.pi/agent/agents/**/*.md)
link "$REPO/agents" "$AGENT_DIR/agents"
# Permission policy baseline (pi-permission-system)
link "$REPO/permission-system/config.json" "$AGENT_DIR/extensions/pi-permission-system/config.json"

# Re-apply the outfitter MCP-state-persistence patch (reverted by `outfitter update`).
"$REPO/bin/pi-fleet-repair"

echo "  ✓ private runtime root: $RUNTIME_ROOT"
echo "Legacy state is never migrated automatically. Inventory safely with: $REPO/bin/pi-fleet-state-migrate"
echo "Apply later only after reviewing that report: $REPO/bin/pi-fleet-state-migrate --apply"
echo "Done. Required global pi packages: pi-mcp-adapter, pi-subagents, @gotgenes/pi-permission-system"
echo "Verify with: pi list"
