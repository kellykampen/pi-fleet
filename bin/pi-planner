#!/usr/bin/env bash
# Hybrid: outfitter composes skill/model/prompt/extensions; this wrapper hardcodes --tools (the boundary).
set -euo pipefail
exec outfitter run --profile planner --agent pi -- --tools read,grep,find,ls,bash,linear_get_issue,linear_list,linear_comment,linear_update,mcp_context7_resolve_library_id,mcp_context7_query_docs "$@"
