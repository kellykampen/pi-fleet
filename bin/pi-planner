#!/usr/bin/env bash
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FLEET_ROOT="$(cd "$DIR/.." && pwd)"
. "$DIR/lib/pi-model-env.sh"
. "$DIR/lib/pi-wrapper-args.sh"
pi_model_override_args planner "" "$@"
pi_sanitize_passthrough_args "$@"
# FLT-67: always YOLO + fail-closed planner-policy for bash (linear-cli / read utils only).
# Enforced flags are last so callers cannot shadow --approve/--tools/--extension.
exec outfitter run --profile planner --agent pi -- \
  ${PI_MODEL_ARGS[@]+"${PI_MODEL_ARGS[@]}"} \
  ${PI_PASSTHROUGH_ARGS[@]+"${PI_PASSTHROUGH_ARGS[@]}"} \
  --approve \
  --no-extensions \
  --extension "$FLEET_ROOT/extensions/linear.ts" \
  --extension "$FLEET_ROOT/extensions/planner-policy.ts" \
  --tools read,grep,find,ls,bash,linear_get_issue,linear_list,linear_comment,linear_update,context7_resolve-library-id,context7_query-docs
