#!/usr/bin/env bash
# Hybrid: outfitter composes skill/model/prompt; this wrapper hardcodes --tools (the boundary) and
# extensions (outfitter/pi resolve profile.yml extension paths relative to cwd, not to profile.yml's
# own location — see FLT-15 — so we resolve them here from the script's own path instead).
set -euo pipefail
FLEET_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# Runtime evidence: personal launchd schedules must never bleed into pi's global scheduler store.
"$FLEET_ROOT/bin/lib/scheduler-status.sh" || echo "pi-project-lead: scheduler-status check failed, continuing" >&2
. "$FLEET_ROOT/bin/lib/pi-model-env.sh"
. "$FLEET_ROOT/bin/lib/runtime-state.sh"
pi_model_override_args project-lead "lead" "$@"
YOLO=""
[ "${FLEET_YOLO:-}" = "1" ] && YOLO="--approve"
# Load only canonical fleet secrets. Parse assignments as data: never source or eval this file.
SECRETS_FILE="$(pi_fleet_runtime_path secrets secrets.env)"
if [[ -e "$SECRETS_FILE" || -L "$SECRETS_FILE" ]]; then
  python3 - "$SECRETS_FILE" <<'PY'
import os, stat, sys
path = sys.argv[1]
st = os.lstat(path)
if not stat.S_ISREG(st.st_mode): raise SystemExit("pi-project-lead: secrets file must be regular")
if st.st_uid != os.getuid(): raise SystemExit("pi-project-lead: secrets file has wrong owner")
if stat.S_IMODE(st.st_mode) & 0o077: raise SystemExit("pi-project-lead: secrets file must not be group/world accessible")
PY
  while IFS= read -r secret_line || [[ -n "$secret_line" ]]; do
    case "$secret_line" in ''|'#'*) continue ;; esac
    case "$secret_line" in *=*) ;; *) echo "pi-project-lead: malformed secrets assignment" >&2; exit 2 ;; esac
    secret_key="${secret_line%%=*}"
    secret_value="${secret_line#*=}"
    case "$secret_key" in E2B_API_KEY|FLEET_GITHUB_TOKEN|GH_TOKEN|FLEET_GITHUB_REVIEWER_TOKEN|FLEET_E2B_TEMPLATE|FLEET_REPO_URL|FLEET_CONVEX_URL|FLEET_CONVEX_TOKEN|OPENAI_API_KEY|OPENROUTER_API_KEY|ANTHROPIC_API_KEY|XAI_API_KEY|GEMINI_API_KEY|GOOGLE_API_KEY|KIMI_API_KEY|MOONSHOT_API_KEY|PI_AGENT_AUTH_JSON_B64|FLEET_GITHUB_APP_ID|FLEET_GITHUB_APP_INSTALLATION_ID|FLEET_GITHUB_APP_PRIVATE_KEY|FLEET_GITHUB_APP_PRIVATE_KEY_PATH) ;; *)
      echo "pi-project-lead: secret key is not allowlisted: $secret_key" >&2; exit 2 ;;
    esac
    [[ "$secret_key" =~ ^[A-Z][A-Z0-9_]*$ && "$secret_value" != *$'\r'* ]] || {
      echo "pi-project-lead: malformed secrets assignment" >&2; exit 2;
    }
    export "$secret_key=$secret_value"
  done < "$SECRETS_FILE"
fi
# FLT-35: --no-extensions blocks machine-global package auto-discovery (e.g. @jl1990/pi-scheduler);
# the explicit --extension flags below are unaffected and still load.
exec outfitter run --profile project-lead --agent pi -- "${PI_MODEL_ARGS[@]+"${PI_MODEL_ARGS[@]}"}" $YOLO \
  --no-extensions \
  --extension "$FLEET_ROOT/extensions/linear.ts" --extension "$FLEET_ROOT/extensions/e2b" \
  --tools read,grep,find,ls,write,edit,bash,linear_get_issue,linear_list,linear_comment,linear_update,e2b_cast,e2b_status,e2b_wait,e2b_cancel,e2b_logs,e2b_port_url "$@"
