#!/usr/bin/env bash
# Hybrid: outfitter composes skill/model/prompt; this wrapper hardcodes --tools (the boundary) and
# extensions (outfitter/pi resolve profile.yml extension paths relative to cwd, not to profile.yml's
# own location — see FLT-15 — so we resolve them here from the script's own path instead).
#
# Project-lead is a routing bottleneck, not a builder: no write/edit tools and an immutable
# project-lead command policy. Coordination/casting/PR/status and narrow main-integration verbs
# remain available; implementation and review work must be cast.
#
# FLT-68: on startup the seat is named <workspace_name>-project-lead (via fleet-lead-mailbox.sh).
# That name is both the cmux pane/tab title target and the fleet-mail mailbox id.
#
# FLT-67: no @gotgenes/pi-permission-system. Always YOLO (--approve). Security boundary is the
# --tools allowlist (no write/edit) + immutable extensions/project-lead-policy.ts bash gate.
set -euo pipefail
FLEET_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# Runtime evidence: personal launchd schedules must never bleed into pi's global scheduler store.
"$FLEET_ROOT/bin/lib/scheduler-status.sh" || echo "pi-project-lead: scheduler-status check failed, continuing" >&2
. "$FLEET_ROOT/bin/lib/pi-model-env.sh"
. "$FLEET_ROOT/bin/lib/pi-wrapper-args.sh"
. "$FLEET_ROOT/bin/lib/runtime-state.sh"
. "$FLEET_ROOT/bin/lib/pi-project-lead-runtime.sh"
pi_model_override_args project-lead "lead" "$@"
pi_sanitize_passthrough_args "$@"
# Load only canonical fleet secrets. Parse assignments as data: never source or eval this file.
SECRETS_FILE="$(pi_fleet_runtime_path secrets secrets.env)"
if [[ -e "$SECRETS_FILE" || -L "$SECRETS_FILE" ]]; then
  python3 - "$SECRETS_FILE" <<'PYSEC'
import os, stat, sys
path = sys.argv[1]
st = os.lstat(path)
if not stat.S_ISREG(st.st_mode): raise SystemExit("pi-project-lead: secrets file must be regular")
if st.st_uid != os.getuid(): raise SystemExit("pi-project-lead: secrets file has wrong owner")
if stat.S_IMODE(st.st_mode) & 0o077: raise SystemExit("pi-project-lead: secrets file must not be group/world accessible")
PYSEC
  normalized_secrets="$(python3 - "$SECRETS_FILE" <<'PYSEC'
import shlex, sys
for number, raw in enumerate(open(sys.argv[1], encoding="utf-8"), 1):
    line = raw.rstrip("\n")
    stripped = line.strip()
    if not stripped or stripped.startswith("#"):
        print(line)
        continue
    legacy = stripped.startswith("export ") or ("=" in stripped and stripped.split("=", 1)[1].startswith(("'", '"')))
    if not legacy:
        print(line)
        continue
    try: fields = shlex.split(stripped, comments=False, posix=True)
    except ValueError as error: raise SystemExit(f"pi-project-lead: malformed quoted secrets assignment on line {number}") from error
    if fields and fields[0] == "export": fields = fields[1:]
    if len(fields) != 1 or "=" not in fields[0]:
        raise SystemExit(f"pi-project-lead: malformed legacy secrets assignment on line {number}")
    print(fields[0])
PYSEC
)"
  while IFS= read -r secret_line || [[ -n "$secret_line" ]]; do
    case "$secret_line" in ''|'#'*) continue ;; esac
    case "$secret_line" in *=*) ;; *) echo "pi-project-lead: malformed secrets assignment" >&2; exit 2 ;; esac
    secret_key="${secret_line%%=*}"
    secret_value="${secret_line#*=}"
    # FLEET_YOLO is an operational toggle, not a secret. Older migrated secrets.env files may
    # contain it; ignore it here so it cannot silently enable approval in child processes.
    case "$secret_key" in FLEET_YOLO) continue ;; esac
    case "$secret_key" in E2B_API_KEY|FLEET_GITHUB_TOKEN|GH_TOKEN|FLEET_GITHUB_REVIEWER_TOKEN|FLEET_E2B_TEMPLATE|FLEET_REPO_URL|FLEET_CONVEX_URL|FLEET_CONVEX_TOKEN|OPENAI_API_KEY|OPENROUTER_API_KEY|ANTHROPIC_API_KEY|XAI_API_KEY|GEMINI_API_KEY|GOOGLE_API_KEY|KIMI_API_KEY|MOONSHOT_API_KEY|PI_AGENT_AUTH_JSON_B64|FLEET_GITHUB_APP_ID|FLEET_GITHUB_APP_INSTALLATION_ID|FLEET_GITHUB_APP_PRIVATE_KEY|FLEET_GITHUB_APP_PRIVATE_KEY_PATH) ;; *)
      echo "pi-project-lead: secret key is not allowlisted: $secret_key" >&2; exit 2 ;;
    esac
    [[ "$secret_key" =~ ^[A-Z][A-Z0-9_]*$ && "$secret_value" != *$'\r'* ]] || {
      echo "pi-project-lead: malformed secrets assignment" >&2; exit 2;
    }
    export "$secret_key=$secret_value"
  done <<< "$normalized_secrets"
fi
# Isolated overlay + policy cwd; no permission-system package or config.
pi_project_lead_prepare_runtime "$FLEET_ROOT"
# FLT-35: --no-extensions blocks machine-global package auto-discovery (e.g. @jl1990/pi-scheduler);
# the explicit --extension flags below are unaffected and still load.
# FLT-66/FLT-67: always --approve (CEO always-YOLO). No permission-system extension.
# Re-include pi-xai-oauth (registers provider xai-auth) so Grok casts work under --no-extensions.
. "$FLEET_ROOT/bin/lib/pi-xai-oauth-ext.sh"
exec outfitter run --profile project-lead --agent pi -- \
  ${PI_MODEL_ARGS[@]+"${PI_MODEL_ARGS[@]}"} \
  ${PI_PASSTHROUGH_ARGS[@]+"${PI_PASSTHROUGH_ARGS[@]}"} \
  --approve \
  --no-extensions \
  --extension "$FLEET_ROOT/extensions/linear.ts" --extension "$FLEET_ROOT/extensions/e2b" \
  --extension "$FLEET_ROOT/extensions/project-lead-policy.ts" \
  ${PI_XAI_OAUTH_EXT_ARGS[@]+"${PI_XAI_OAUTH_EXT_ARGS[@]}"} \
  --tools read,grep,find,ls,bash,linear_get_issue,linear_list,linear_comment,linear_update,e2b_cast,e2b_status,e2b_wait,e2b_cancel,e2b_logs,e2b_port_url
