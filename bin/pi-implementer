#!/usr/bin/env bash
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$DIR/lib/peek-env.sh"
. "$DIR/lib/pi-model-env.sh"
PI_MODEL_ARGS="$(pi_model_override_args implementer "" "$@")"
# shellcheck disable=SC2086
exec outfitter run --profile implementer --agent pi -- $PI_MODEL_ARGS --tools read,grep,find,ls,write,edit,bash,linear_get_issue,linear_list,context7_resolve-library-id,context7_query-docs,convex_status,convex_tables,convex_functionSpec,convex_data,convex_run,convex_runOneoffQuery,convex_logs "$@"
