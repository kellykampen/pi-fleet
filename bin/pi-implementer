#!/usr/bin/env bash
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$DIR/lib/pi-model-env.sh"
pi_model_override_args implementer "" "$@"
YOLO=""
[ "${FLEET_YOLO:-}" = "1" ] && YOLO="--approve"
exec outfitter run --profile implementer --agent pi -- "${PI_MODEL_ARGS[@]+"${PI_MODEL_ARGS[@]}"}" $YOLO --tools read,grep,find,ls,write,edit,bash,linear_get_issue,linear_list,context7_resolve-library-id,context7_query-docs,convex_status,convex_tables,convex_functionSpec,convex_data,convex_run,convex_runOneoffQuery,convex_logs "$@"
