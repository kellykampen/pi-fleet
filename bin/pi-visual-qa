#!/usr/bin/env bash
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$DIR/lib/peek-env.sh"
. "$DIR/lib/pi-model-env.sh"
PI_MODEL_ARGS="$(pi_model_override_args visual-qa "" "$@")"
# shellcheck disable=SC2086
exec outfitter run --profile visual-qa --agent pi -- $PI_MODEL_ARGS --tools read,grep,find,ls,bash,playwright_browser_navigate,playwright_browser_take_screenshot,playwright_browser_snapshot,playwright_browser_resize,playwright_browser_wait_for,playwright_browser_click,playwright_browser_tabs,playwright_browser_console_messages "$@"
