#!/usr/bin/env bash
# pi-fleet-eval-model-overrides — deterministic check for wrapper model/provider env override merging.
# No real agent launch: mocks outfitter and asserts the args each wrapper would hand to Pi.
set -uo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
TMP="$(mktemp -d)"
OUT="${1:-$TMP/model-overrides-latest.txt}"
trap 'rm -rf "$TMP"' EXIT
exec > >(tee "$OUT") 2>&1

# FLT-67: permission-system package is not required for any seat launch.
XAI_OAUTH_EXT="$TMP/agent/npm/node_modules/pi-xai-oauth/extensions/xai-oauth.ts"
mkdir -p "$(dirname "$XAI_OAUTH_EXT")"
touch "$XAI_OAUTH_EXT"

pass=0; fail=0
check_contains() {
  local desc="$1" got="$2" want="$3"
  if [[ "$got" == *"$want"* ]]; then
    pass=$((pass + 1)); echo "PASS: $desc"
  else
    fail=$((fail + 1)); echo "FAIL: $desc"; echo "  got:  $got"; echo "  want contains: $want"
  fi
}
check_not_contains() {
  local desc="$1" got="$2" banned="$3"
  if [[ "$got" != *"$banned"* ]]; then
    pass=$((pass + 1)); echo "PASS: $desc"
  else
    fail=$((fail + 1)); echo "FAIL: $desc"; echo "  got: $got"; echo "  banned: $banned"
  fi
}

cat > "$TMP/outfitter" <<'SH'
#!/usr/bin/env bash
printf '%q ' "$@" > "$PI_FLEET_MOCK_OUT"
printf '\n' >> "$PI_FLEET_MOCK_OUT"
SH
chmod +x "$TMP/outfitter"

run_wrapper() {
  local outfile="$TMP/args.txt"
  : > "$outfile"
  env -i HOME="$HOME" PATH="$TMP:$PATH" PI_FLEET_HOME="$TMP/fleet-home" \
    PI_CODING_AGENT_DIR="$TMP/agent" FLEET_CONDUCTOR_RUNTIME_DIR="$TMP/conductor-runtime" \
    FLEET_PROJECT_LEAD_RUNTIME_DIR="$TMP/project-lead-runtime" \
    FLEET_IMPLEMENTER_RUNTIME_DIR="$TMP/implementer-runtime" \
    PI_XAI_OAUTH_EXT="$XAI_OAUTH_EXT" \
    PI_SCHEDULER_TASKS_FILE="$TMP/scheduler-tasks.json" PI_SCHEDULER_TASKS_BOUNDARY="$TMP" \
    PI_FLEET_MOCK_OUT="$outfile" "$@"
  cat "$outfile"
}

args="$(run_wrapper PI_IMPLEMENTER_PROVIDER=openai-codex PI_IMPLEMENTER_MODEL=gpt-5.6-sol "$ROOT/bin/pi-implementer" -p noop)"
check_contains "role-specific env controls implementer provider/model" "$args" "-- --provider openai-codex --model gpt-5.6-sol"
check_contains "implementer model override precedes enforced seat flags" "$args" "--model gpt-5.6-sol"
check_contains "implementer always passes --approve (always YOLO, FLT-67)" "$args" "--approve --no-extensions"
check_contains "implementer always passes --no-extensions" "$args" "--no-extensions"
check_not_contains "implementer does not load permission-system" "$args" "pi-permission-system"
check_contains "implementer loads explicit linear extension" "$args" "--extension $ROOT/extensions/linear.ts"
check_contains "implementer re-includes pi-xai-oauth for xai-auth under --no-extensions" "$args" \
  "--extension $XAI_OAUTH_EXT"

args="$(run_wrapper FLEET_YOLO=0 PI_IMPLEMENTER_PROVIDER=openai-codex PI_IMPLEMENTER_MODEL=gpt-5.6-sol "$ROOT/bin/pi-implementer" -p noop)"
check_contains "implementer still --approve when FLEET_YOLO=0" "$args" "--approve --no-extensions"

args="$(run_wrapper FLEET_YOLO=1 PI_IMPLEMENTER_PROVIDER=openai-codex PI_IMPLEMENTER_MODEL=gpt-5.6-sol "$ROOT/bin/pi-implementer" -p noop)"
check_contains "implementer still --approve when FLEET_YOLO=1" "$args" "--approve --no-extensions"
check_contains "implementer keeps provider/model when FLEET_YOLO=1" "$args" "--provider openai-codex --model gpt-5.6-sol"

args="$(run_wrapper PI_PROVIDER=openai-codex PI_MODEL=gpt-5.5 "$ROOT/bin/pi-reviewer" -p noop)"
check_contains "generic env controls reviewer provider/model" "$args" "-- --provider openai-codex --model gpt-5.5"
# FLT-60: reviewer is always unattended — --approve is not gated on FLEET_YOLO.
check_contains "reviewer always passes --approve (unattended QC)" "$args" "--approve --no-extensions"
check_contains "reviewer always passes --no-extensions" "$args" "--no-extensions"
check_not_contains "reviewer does not load permission-system" "$args" "pi-permission-system"
check_contains "reviewer re-includes pi-xai-oauth for xai-auth under --no-extensions" "$args" \
  "--extension $XAI_OAUTH_EXT"

args="$(run_wrapper FLEET_YOLO=0 PI_PROVIDER=openai-codex PI_MODEL=gpt-5.5 "$ROOT/bin/pi-reviewer" -p noop)"
check_contains "reviewer still --approve when FLEET_YOLO=0" "$args" "--approve --no-extensions"

args="$(run_wrapper PI_PROVIDER=openai-codex PI_MODEL=gpt-5.5 PI_AC_VERIFIER_MODEL=gpt-5.6-luna "$ROOT/bin/pi-ac-verifier" -p noop)"
check_contains "role env beats generic env for ac-verifier model" "$args" "-- --provider openai-codex --model gpt-5.6-luna"
check_not_contains "ac-verifier role model suppresses generic env model" "$args" "--model gpt-5.5"
# FLT-60: ac-verifier is always unattended — --approve is not gated on FLEET_YOLO.
check_contains "ac-verifier always passes --approve (unattended QC)" "$args" "--approve --no-extensions"
check_not_contains "ac-verifier does not load permission-system" "$args" "pi-permission-system"
check_contains "ac-verifier re-includes pi-xai-oauth for xai-auth under --no-extensions" "$args" \
  "--extension $XAI_OAUTH_EXT"

args="$(run_wrapper FLEET_YOLO=0 PI_PROVIDER=openai-codex PI_MODEL=gpt-5.5 PI_AC_VERIFIER_MODEL=gpt-5.6-luna "$ROOT/bin/pi-ac-verifier" -p noop)"
check_contains "ac-verifier still --approve when FLEET_YOLO=0" "$args" "--approve --no-extensions"

args="$(run_wrapper PI_PROVIDER=openai-codex PI_LEAD_MODEL=gpt-5.6-sol "$ROOT/bin/pi-project-lead" -p noop)"
check_contains "role alias PI_LEAD_MODEL controls project-lead" "$args" "-- --provider openai-codex --model gpt-5.6-sol"
check_not_contains "project-lead does not pass unsupported --no-lens" "$args" "--no-lens"

# FLT-35/FLT-38 structural fix: --no-extensions must reach outfitter alongside the FLT-34
# model-override argv (not swallowed or reordered by it), and the explicit --extension flags must
# still be present. --no-lens must stay absent because Pi rejects --no-extensions + --no-lens.
check_contains "project-lead passes --no-extensions alongside model-override argv" "$args" "--no-extensions"
check_contains "project-lead model override present with seat flags" "$args" "--model gpt-5.6-sol"
check_contains "project-lead still loads explicit linear/e2b extensions" "$args" \
  "--extension $ROOT/extensions/linear.ts --extension $ROOT/extensions/e2b"
check_not_contains "project-lead does not load permission-system package" "$args" "pi-permission-system"
check_contains "project-lead loads immutable project-lead policy extension" "$args" \
  "--extension $ROOT/extensions/project-lead-policy.ts"
check_contains "project-lead always passes --approve" "$args" "--approve --no-extensions"
# Mock outfitter shell-quotes commas as \, so match the escaped form printed into args.
check_contains "project-lead tools keep coordination surface without write/edit" "$args" \
  '--tools read\,grep\,find\,ls\,bash\,linear_get_issue\,linear_list\,linear_comment\,linear_update\,e2b_cast\,e2b_status\,e2b_wait\,e2b_cancel\,e2b_logs\,e2b_port_url'
check_not_contains "project-lead tools omit write" "$args" "write,"
check_not_contains "project-lead tools omit edit" "$args" ",edit,"
# Lead must re-include pi-xai-oauth after --no-extensions so xai-auth works.
check_contains "project-lead re-includes pi-xai-oauth for xai-auth under --no-extensions" "$args" \
  "--extension $XAI_OAUTH_EXT"

args="$(run_wrapper FLEET_YOLO=1 PI_PROVIDER=openai-codex PI_LEAD_MODEL=gpt-5.6-sol "$ROOT/bin/pi-project-lead" -p noop)"
check_contains "project-lead keeps --approve before --no-extensions" "$args" "--approve --no-extensions"
check_not_contains "project-lead yolo argv still omits unsupported --no-lens" "$args" "--no-lens"

args="$(run_wrapper FLEET_YOLO=0 PI_PROVIDER=openai-codex PI_LEAD_MODEL=gpt-5.6-sol "$ROOT/bin/pi-project-lead" -p noop)"
check_contains "project-lead still --approve when FLEET_YOLO=0" "$args" "--approve --no-extensions"
check_contains "project-lead keeps model when FLEET_YOLO=0" "$args" "--model gpt-5.6-sol"

args="$(run_wrapper PI_PROVIDER=openai-codex PI_MODEL=gpt-5.6-sol "$ROOT/bin/pi-conductor" -p noop)"
check_contains "generic env controls conductor provider/model" "$args" "-- --provider openai-codex --model gpt-5.6-sol"
check_contains "conductor passes --no-extensions alongside model-override argv" "$args" "--no-extensions"
check_contains "conductor still loads explicit linear extension" "$args" "--extension $ROOT/extensions/linear.ts"
check_contains "conductor always passes --approve (always YOLO, FLT-67)" "$args" "--approve --no-extensions"
check_not_contains "conductor does not load permission-system" "$args" "pi-permission-system"
check_contains "conductor re-includes pi-xai-oauth for xai-auth under --no-extensions" "$args" \
  "--extension $XAI_OAUTH_EXT"

args="$(run_wrapper FLEET_YOLO=0 PI_PROVIDER=openai-codex PI_MODEL=gpt-5.6-sol "$ROOT/bin/pi-conductor" -p noop)"
check_contains "conductor still --approve when FLEET_YOLO=0" "$args" "--approve --no-extensions"
check_contains "conductor keeps model when FLEET_YOLO=0" "$args" "--model gpt-5.6-sol"

args="$(run_wrapper FLEET_YOLO=1 PI_PROVIDER=openai-codex PI_MODEL=gpt-5.6-sol "$ROOT/bin/pi-conductor" -p noop)"
check_contains "conductor keeps --approve before --no-extensions" "$args" "--approve --no-extensions"

args="$(run_wrapper PI_PROVIDER=env-provider PI_MODEL=env-model "$ROOT/bin/pi-implementer" --provider explicit-provider --model explicit-model -p noop)"
check_not_contains "explicit CLI provider/model suppress env defaults" "$args" "env-provider"
check_not_contains "explicit CLI model suppresses env model" "$args" "env-model"
check_contains "explicit CLI provider/model are preserved" "$args" "--provider explicit-provider --model explicit-model"

args="$(run_wrapper PI_PLANNER_PROVIDER=openai-codex PI_PLANNER_MODEL=gpt-5.6-terra "$ROOT/bin/pi-planner" -p noop)"
check_contains "role-specific env controls planner provider/model" "$args" "-- --provider openai-codex --model gpt-5.6-terra"
check_contains "planner loads planner-policy extension" "$args" "planner-policy.ts"
check_contains "planner passes --no-extensions" "$args" "--no-extensions"
check_contains "planner always passes --approve" "$args" "--approve"
check_contains "planner always passes --tools" "$args" "--tools"
check_contains "planner re-includes pi-xai-oauth for xai-auth under --no-extensions" "$args" \
  "--extension $XAI_OAUTH_EXT"

args="$(run_wrapper FLEET_YOLO=0 PI_PLANNER_PROVIDER=openai-codex PI_PLANNER_MODEL=gpt-5.6-terra "$ROOT/bin/pi-planner" -p noop)"
check_contains "planner still --approve when FLEET_YOLO=0" "$args" "--approve"
check_contains "planner keeps provider/model when FLEET_YOLO=0" "$args" "--provider openai-codex --model gpt-5.6-terra"

args="$(run_wrapper PI_SPIKE_BREAKDOWN_PROVIDER=openai-codex PI_SPIKE_BREAKDOWN_MODEL=gpt-5.6-terra "$ROOT/bin/pi-spike-breakdown" -p noop)"
check_contains "role-specific env controls spike-breakdown provider/model" "$args" "-- --provider openai-codex --model gpt-5.6-terra"
check_contains "spike-breakdown loads spike-breakdown-policy extension" "$args" "spike-breakdown-policy.ts"
check_contains "spike-breakdown passes --no-extensions" "$args" "--no-extensions"
check_contains "spike-breakdown always passes --approve" "$args" "--approve"
check_contains "spike-breakdown always passes --tools" "$args" "--tools"
check_contains "spike-breakdown re-includes pi-xai-oauth for xai-auth under --no-extensions" "$args" \
  "--extension $XAI_OAUTH_EXT"

args="$(run_wrapper FLEET_YOLO=0 PI_SPIKE_BREAKDOWN_PROVIDER=openai-codex PI_SPIKE_BREAKDOWN_MODEL=gpt-5.6-terra "$ROOT/bin/pi-spike-breakdown" -p noop)"
check_contains "spike-breakdown still --approve when FLEET_YOLO=0" "$args" "--approve"
check_contains "spike-breakdown keeps provider/model when FLEET_YOLO=0" "$args" "--provider openai-codex --model gpt-5.6-terra"

args="$(run_wrapper PI_REMOTION_PROVIDER=openai-codex PI_REMOTION_MODEL=gpt-5.6-terra "$ROOT/bin/pi-remotion" -p noop)"
check_contains "role-specific env controls remotion provider/model" "$args" "-- --provider openai-codex --model gpt-5.6-terra"
check_contains "remotion always passes --approve" "$args" "--approve"

args="$(run_wrapper PI_RESEARCHER_PROVIDER=openai-codex PI_RESEARCHER_MODEL=gpt-5.5 "$ROOT/bin/pi-researcher" -p noop)"
check_contains "role-specific env controls researcher provider/model" "$args" "-- --provider openai-codex --model gpt-5.5"
check_contains "researcher always passes --approve" "$args" "--approve"

args="$(run_wrapper PI_PERSONAL_ASSISTANT_PROVIDER=openai-codex PI_PERSONAL_ASSISTANT_MODEL=gpt-5.6-terra \
  PI_SCHEDULE_SYNC_DRY_RUN=1 PI_SCHEDULE_SYNC_AGENTS_DIR="$TMP/agents" PI_SCHEDULE_SYNC_LOG_DIR="$TMP/logs" \
  "$ROOT/bin/pi-personal-assistant" -p noop)"
check_contains "role-specific env controls personal-assistant provider/model" "$args" "-- --provider openai-codex --model gpt-5.6-terra"
check_contains "personal-assistant always passes --approve" "$args" "--approve"

# Regression guard: bin/lib/pi-model-env.sh populates PI_MODEL_ARGS as a bash array and wrappers
# expand it as "${PI_MODEL_ARGS[@]+"${PI_MODEL_ARGS[@]}"}". Without the [@]+ guard, expanding an
# empty array under `set -u` throws "unbound variable" on bash 3.2 (macOS's default /bin/bash),
# i.e. every wrapper invocation with zero overrides would crash.
args="$(run_wrapper "$ROOT/bin/pi-researcher" -p noop)"
check_contains "no override still launches (empty PI_MODEL_ARGS array under set -u)" "$args" '--approve'
check_contains "no override researcher tools present" "$args" '--tools read\,grep\,find\,ls\,context7_resolve-library-id\,context7_query-docs'
check_not_contains "no override does not emit a stray --provider/--model" "$args" "--provider"

if [ "$fail" -eq 0 ]; then
  echo "VERDICT: PASS ($pass checks)"
else
  echo "VERDICT: FAIL ($fail failed, $pass passed)"
fi
exit "$fail"
