#!/usr/bin/env bash
# pi-fleet-eval-model-overrides — deterministic check for wrapper model/provider env override merging.
# No real agent launch: mocks outfitter and asserts the args each wrapper would hand to Pi.
set -uo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
TMP="$(mktemp -d)"
OUT="${1:-$TMP/model-overrides-latest.txt}"
trap 'rm -rf "$TMP"' EXIT
exec > >(tee "$OUT") 2>&1

pass=0; fail=0
check_contains() {
  local desc="$1" got="$2" want="$3"
  if [[ "$got" == *"$want"* ]]; then
    pass=$((pass + 1)); echo "PASS: $desc"
  else
    fail=$((fail + 1)); echo "FAIL: $desc"; echo "  got:  $got"; echo "  want contains: $want"
  fi
}
check_not_contains() {
  local desc="$1" got="$2" banned="$3"
  if [[ "$got" != *"$banned"* ]]; then
    pass=$((pass + 1)); echo "PASS: $desc"
  else
    fail=$((fail + 1)); echo "FAIL: $desc"; echo "  got: $got"; echo "  banned: $banned"
  fi
}

cat > "$TMP/outfitter" <<'SH'
#!/usr/bin/env bash
printf '%q ' "$@" > "$PI_FLEET_MOCK_OUT"
printf '\n' >> "$PI_FLEET_MOCK_OUT"
SH
chmod +x "$TMP/outfitter"

run_wrapper() {
  local outfile="$TMP/args.txt"
  : > "$outfile"
  env -i HOME="$HOME" PATH="$TMP:$PATH" PI_FLEET_HOME="$TMP/fleet-home" \
    PI_SCHEDULER_TASKS_FILE="$TMP/scheduler-tasks.json" PI_SCHEDULER_TASKS_BOUNDARY="$TMP" \
    PI_FLEET_MOCK_OUT="$outfile" "$@"
  cat "$outfile"
}

args="$(run_wrapper PI_IMPLEMENTER_PROVIDER=openai-codex PI_IMPLEMENTER_MODEL=gpt-5.6-sol "$ROOT/bin/pi-implementer" -p noop)"
check_contains "role-specific env controls implementer provider/model" "$args" "-- --provider openai-codex --model gpt-5.6-sol --tools"
check_not_contains "implementer does not pass --approve unless FLEET_YOLO=1" "$args" "--approve"

# Contract is exact-match FLEET_YOLO=1, not truthiness: a non-1 value must NOT enable --approve.
args="$(run_wrapper FLEET_YOLO=0 PI_IMPLEMENTER_PROVIDER=openai-codex PI_IMPLEMENTER_MODEL=gpt-5.6-sol "$ROOT/bin/pi-implementer" -p noop)"
check_not_contains "implementer treats FLEET_YOLO=0 as off (exact-match, not truthy)" "$args" "--approve"

args="$(run_wrapper FLEET_YOLO=1 PI_IMPLEMENTER_PROVIDER=openai-codex PI_IMPLEMENTER_MODEL=gpt-5.6-sol "$ROOT/bin/pi-implementer" -p noop)"
check_contains "implementer maps FLEET_YOLO=1 to --approve" "$args" "-- --provider openai-codex --model gpt-5.6-sol --approve --tools"

args="$(run_wrapper PI_PROVIDER=openai-codex PI_MODEL=gpt-5.5 "$ROOT/bin/pi-reviewer" -p noop)"
check_contains "generic env controls reviewer provider/model" "$args" "-- --provider openai-codex --model gpt-5.5 --tools"

args="$(run_wrapper PI_PROVIDER=openai-codex PI_MODEL=gpt-5.5 PI_AC_VERIFIER_MODEL=gpt-5.6-luna "$ROOT/bin/pi-ac-verifier" -p noop)"
check_contains "role env beats generic env for ac-verifier model" "$args" "-- --provider openai-codex --model gpt-5.6-luna --tools"

args="$(run_wrapper PI_PROVIDER=openai-codex PI_LEAD_MODEL=gpt-5.6-sol "$ROOT/bin/pi-project-lead" -p noop)"
check_contains "role alias PI_LEAD_MODEL controls project-lead" "$args" "-- --provider openai-codex --model gpt-5.6-sol --no-extensions"
check_not_contains "project-lead does not pass unsupported --no-lens" "$args" "--no-lens"

# FLT-35/FLT-38 structural fix: --no-extensions must reach outfitter alongside the FLT-34
# model-override argv (not swallowed or reordered by it), and the explicit --extension flags must
# still be present. --no-lens must stay absent because Pi rejects --no-extensions + --no-lens.
check_contains "project-lead passes --no-extensions alongside model-override argv" "$args" "--model gpt-5.6-sol --no-extensions"
check_contains "project-lead still loads explicit linear/e2b extensions" "$args" \
  "--extension $ROOT/extensions/linear.ts --extension $ROOT/extensions/e2b"
# When pi-xai-oauth is installed, lead must re-include it after --no-extensions so xai-auth works.
XAI_OAUTH_EXT="${HOME}/.pi/agent/npm/node_modules/pi-xai-oauth/extensions/xai-oauth.ts"
if [ -f "$XAI_OAUTH_EXT" ]; then
  check_contains "project-lead re-includes pi-xai-oauth for xai-auth under --no-extensions" "$args" \
    "--extension $XAI_OAUTH_EXT"
fi

args="$(run_wrapper FLEET_YOLO=1 PI_PROVIDER=openai-codex PI_LEAD_MODEL=gpt-5.6-sol "$ROOT/bin/pi-project-lead" -p noop)"
check_contains "project-lead maps FLEET_YOLO=1 to --approve before --no-extensions" "$args" "--model gpt-5.6-sol --approve --no-extensions"
check_not_contains "project-lead yolo argv still omits unsupported --no-lens" "$args" "--no-lens"

args="$(run_wrapper PI_PROVIDER=openai-codex PI_MODEL=gpt-5.6-sol "$ROOT/bin/pi-conductor" -p noop)"
check_contains "generic env controls conductor provider/model" "$args" "-- --provider openai-codex --model gpt-5.6-sol"
check_contains "conductor passes --no-extensions alongside model-override argv" "$args" "--no-extensions"
check_contains "conductor still loads explicit linear extension" "$args" "--extension $ROOT/extensions/linear.ts"
check_not_contains "conductor does not pass --approve unless FLEET_YOLO=1" "$args" "--approve"
if [ -f "$XAI_OAUTH_EXT" ]; then
  check_contains "conductor re-includes pi-xai-oauth for xai-auth under --no-extensions" "$args" \
    "--extension $XAI_OAUTH_EXT"
fi

args="$(run_wrapper FLEET_YOLO=1 PI_PROVIDER=openai-codex PI_MODEL=gpt-5.6-sol "$ROOT/bin/pi-conductor" -p noop)"
check_contains "conductor maps FLEET_YOLO=1 to --approve before --no-extensions" "$args" "--model gpt-5.6-sol --approve --no-extensions"

args="$(run_wrapper PI_PROVIDER=env-provider PI_MODEL=env-model "$ROOT/bin/pi-implementer" --provider explicit-provider --model explicit-model -p noop)"
check_not_contains "explicit CLI provider/model suppress env defaults" "$args" "env-provider"
check_not_contains "explicit CLI model suppresses env model" "$args" "env-model"
check_contains "explicit CLI provider/model are preserved" "$args" "--provider explicit-provider --model explicit-model"

args="$(run_wrapper PI_PLANNER_PROVIDER=openai-codex PI_PLANNER_MODEL=gpt-5.6-terra "$ROOT/bin/pi-planner" -p noop)"
check_contains "role-specific env controls planner provider/model" "$args" "-- --provider openai-codex --model gpt-5.6-terra --tools"

args="$(run_wrapper FLEET_YOLO=1 PI_PLANNER_PROVIDER=openai-codex PI_PLANNER_MODEL=gpt-5.6-terra "$ROOT/bin/pi-planner" -p noop)"
check_contains "planner maps FLEET_YOLO=1 to --approve" "$args" "-- --provider openai-codex --model gpt-5.6-terra --approve --tools"

args="$(run_wrapper PI_SPIKE_BREAKDOWN_PROVIDER=openai-codex PI_SPIKE_BREAKDOWN_MODEL=gpt-5.6-terra "$ROOT/bin/pi-spike-breakdown" -p noop)"
check_contains "role-specific env controls spike-breakdown provider/model" "$args" "-- --provider openai-codex --model gpt-5.6-terra --tools"
check_not_contains "spike-breakdown does not hardcode --approve outside FLEET_YOLO=1" "$args" "--approve"

args="$(run_wrapper FLEET_YOLO=1 PI_SPIKE_BREAKDOWN_PROVIDER=openai-codex PI_SPIKE_BREAKDOWN_MODEL=gpt-5.6-terra "$ROOT/bin/pi-spike-breakdown" -p noop)"
check_contains "spike-breakdown maps FLEET_YOLO=1 to --approve" "$args" "-- --provider openai-codex --model gpt-5.6-terra --approve --tools"

args="$(run_wrapper PI_REMOTION_PROVIDER=openai-codex PI_REMOTION_MODEL=gpt-5.6-terra "$ROOT/bin/pi-remotion" -p noop)"
check_contains "role-specific env controls remotion provider/model" "$args" "-- --provider openai-codex --model gpt-5.6-terra --tools"

args="$(run_wrapper PI_RESEARCHER_PROVIDER=openai-codex PI_RESEARCHER_MODEL=gpt-5.5 "$ROOT/bin/pi-researcher" -p noop)"
check_contains "role-specific env controls researcher provider/model" "$args" "-- --provider openai-codex --model gpt-5.5 --tools"

args="$(run_wrapper PI_PERSONAL_ASSISTANT_PROVIDER=openai-codex PI_PERSONAL_ASSISTANT_MODEL=gpt-5.6-terra \
  PI_SCHEDULE_SYNC_DRY_RUN=1 PI_SCHEDULE_SYNC_AGENTS_DIR="$TMP/agents" PI_SCHEDULE_SYNC_LOG_DIR="$TMP/logs" \
  "$ROOT/bin/pi-personal-assistant" -p noop)"
check_contains "role-specific env controls personal-assistant provider/model" "$args" "-- --provider openai-codex --model gpt-5.6-terra --tools"

# Regression guard: bin/lib/pi-model-env.sh populates PI_MODEL_ARGS as a bash array and wrappers
# expand it as "${PI_MODEL_ARGS[@]+"${PI_MODEL_ARGS[@]}"}". Without the [@]+ guard, expanding an
# empty array under `set -u` throws "unbound variable" on bash 3.2 (macOS's default /bin/bash),
# i.e. every wrapper invocation with zero overrides would crash.
args="$(run_wrapper "$ROOT/bin/pi-researcher" -p noop)"
check_contains "no override still launches (empty PI_MODEL_ARGS array under set -u)" "$args" '-- --tools read\,grep\,find\,ls\,context7_resolve-library-id\,context7_query-docs'
check_not_contains "no override does not emit a stray --provider/--model" "$args" "--provider"

if [ "$fail" -eq 0 ]; then
  echo "VERDICT: PASS ($pass checks)"
else
  echo "VERDICT: FAIL ($fail failed, $pass passed)"
fi
exit "$fail"
