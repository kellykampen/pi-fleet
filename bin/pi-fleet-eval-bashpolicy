#!/usr/bin/env bash
# pi-fleet-eval-bashpolicy — FLT-67: prove pi-permission-system is NOT in the fleet launch path,
# and that restricted seats still enforce bash policy via immutable command-policy extensions
# (conductor-policy / project-lead-policy / ac-verifier-policy) + wrapper --tools allowlists.
#
# Deterministic structural checks only (no live model). Optional live probe is soft.
set -uo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
OUT="${1:-$ROOT/evals/results/bash-policy-latest.txt}"
mkdir -p "$(dirname "$OUT")"

pass=0; fail=0
ok() { echo "PASS: $1"; pass=$((pass + 1)); }
no() { echo "FAIL: $1"; fail=$((fail + 1)); }

{
  echo "bash-policy eval (FLT-67: no pi-permission-system)"
  echo

  if [ ! -e "$ROOT/permission-system" ]; then
    ok "permission-system/ directory absent"
  else
    no "permission-system/ directory absent"
  fi

  for f in \
    bin/pi-conductor \
    bin/pi-project-lead \
    bin/pi-implementer \
    bin/pi-reviewer \
    bin/pi-ac-verifier \
    bin/pi-docs \
    bin/lib/pi-conductor-runtime.sh \
    bin/lib/pi-project-lead-runtime.sh \
    setup.sh \
    bin/pi-fleet-bootstrap; do
    # Operational wiring only: ignore comments. Fail on --extension/.../pi-permission-system,
    # PI_PERMISSION_SYSTEM_PATH assignments/exports used as values, or pi install of the package.
    if python3 - "$ROOT/$f" <<'PYCHK'
import re, sys
text = open(sys.argv[1], encoding="utf-8").read()
# Strip full-line comments and trailing comments roughly for shell files
lines = []
for line in text.splitlines():
    stripped = line.lstrip()
    if stripped.startswith("#"):
        continue
    # drop inline comment after unquoted #
    if "#" in line:
        # keep code before # when not inside quotes (simple heuristic)
        in_s = in_d = False
        out = []
        for ch in line:
            if ch == "'" and not in_d: in_s = not in_s
            elif ch == '"' and not in_s: in_d = not in_d
            elif ch == "#" and not in_s and not in_d: break
            out.append(ch)
        line = "".join(out)
    lines.append(line)
code = "\n".join(lines)
bad = [
    r"PI_PERMISSION_SYSTEM_PATH\s*=",
    r"--extension\s+[\"']?\$PI_PERMISSION_SYSTEM_PATH",
    r"--extension\s+[\"']?[^\s\"']*pi-permission-system",
    r"pi install npm:@gotgenes/pi-permission-system",
    r"permission-system/(config|conductor|project-lead)\.json",
]
for pat in bad:
    if re.search(pat, code):
        sys.exit(1)
sys.exit(0)
PYCHK
    then
      ok "$f has no PS package path wiring"
    else
      no "$f has no PS package path wiring"
    fi
  done

  # Wrappers always --approve
  for f in bin/pi-conductor bin/pi-project-lead bin/pi-implementer bin/pi-reviewer bin/pi-ac-verifier; do
    if grep -q -- '--approve' "$ROOT/$f"; then
      ok "$f always YOLO (--approve present)"
    else
      no "$f always YOLO (--approve present)"
    fi
  done

  # Policy extensions still present and seat-scoped
  if grep -q 'seat: "conductor"' "$ROOT/extensions/conductor-policy.ts"; then
    ok "conductor-policy.ts still gates seat conductor"
  else
    no "conductor-policy.ts still gates seat conductor"
  fi
  if grep -q 'seat: "lead"' "$ROOT/extensions/project-lead-policy.ts"; then
    ok "project-lead-policy.ts still gates seat lead"
  else
    no "project-lead-policy.ts still gates seat lead"
  fi
  if [ -f "$ROOT/extensions/ac-verifier-policy.ts" ]; then
    ok "ac-verifier-policy.ts present"
  else
    no "ac-verifier-policy.ts present"
  fi
  if [ -f "$ROOT/extensions/planner-policy.ts" ]; then
    ok "planner-policy.ts present"
  else
    no "planner-policy.ts present"
  fi
  if [ -f "$ROOT/extensions/spike-breakdown-policy.ts" ]; then
    ok "spike-breakdown-policy.ts present"
  else
    no "spike-breakdown-policy.ts present"
  fi

  # Unit: command policy still denies destructive patterns for lead/conductor.
  # Run from $ROOT so the relative stdin ESM import resolves regardless of caller cwd.
  if ( cd "$ROOT" && node --input-type=module - <<'JS'
import assert from "node:assert/strict";
import { evaluateCommand } from "./bin/lib/conductor-command-policy.mjs";
for (const seat of ["conductor", "lead"]) {
  assert.equal(evaluateCommand("rm -rf /", { seat, cwd: "/repo" }).allowed, false);
  assert.equal(evaluateCommand("pnpm test", { seat, cwd: "/repo" }).allowed, false);
  assert.equal(evaluateCommand("cmux workspace list", { seat, cwd: "/repo" }).allowed, true);
}
assert.equal(evaluateCommand("git commit -am x", { seat: "lead", cwd: "/repo" }).allowed, false);
assert.equal(evaluateCommand("git push origin main", { seat: "lead", cwd: "/repo" }).allowed, true);
assert.equal(evaluateCommand("git push origin main", { seat: "conductor", cwd: "/repo" }).allowed, false);
const { evaluateLinearSeatCommand } = await import("./bin/lib/linear-seat-command-policy.mjs");
assert.equal(evaluateLinearSeatCommand("linear-cli issues create T -t X -d body").allowed, true);
assert.equal(evaluateLinearSeatCommand("pi-fleet-spike-interview run --issue S-1 --questions q.json").allowed, true);
assert.equal(evaluateLinearSeatCommand("pnpm test").allowed, false);
assert.equal(evaluateLinearSeatCommand("git commit -am x").allowed, false);
assert.equal(evaluateLinearSeatCommand("rm -rf /").allowed, false);
console.log("ok");
JS
  ); then
    ok "command-policy unit denies destructive / implementation shell"
  else
    no "command-policy unit denies destructive / implementation shell"
  fi


  for f in bin/pi-planner bin/pi-spike-breakdown; do
    if grep -q -- '--approve' "$ROOT/$f" && grep -q 'planner-policy\|spike-breakdown-policy' "$ROOT/$f"; then
      ok "$f always YOLO + linear-seat policy extension"
    else
      no "$f always YOLO + linear-seat policy extension"
    fi
    if grep -q 'pi_sanitize_passthrough_args' "$ROOT/$f"; then
      ok "$f sanitizes passthrough args"
    else
      no "$f sanitizes passthrough args"
    fi
  done

  # Optional live headless probe: no PS extension, --approve, allowlisted bash only.
  if command -v pi >/dev/null 2>&1; then
    TESTDIR="/tmp/__pifleet_denytest__"
    rm -rf "$TESTDIR"; mkdir -p "$TESTDIR"; echo "SENTINEL-ALIVE" > "$TESTDIR/sentinel.txt"
    log="/tmp/pi-fleet-bashpolicy.log"
    # Under --no-extensions with no PS, bash is only constrained by --tools; deny of rm is NOT
    # enforced by PS. This probe only proves no ask-modal and that allowlisted bash runs.
    ( cd "$ROOT" && perl -e 'alarm shift; exec @ARGV' 60 \
      pi --no-extensions --approve --tools read,grep,find,ls,bash \
      -p "Run: printf PROBE_OK=1 > $TESTDIR/probe.txt . Reply PROBE_DONE." \
      </dev/null > "$log" 2>&1 ) || true
    if grep -qiE 'permission.*(ask|prompt|denied by user)|Allow this bash|permissions:ui_prompt|\[y/N\]' "$log" 2>/dev/null; then
      no "live headless probe hit a permission ask gate"
      tail -20 "$log" | sed 's/^/  /'
    else
      ok "live headless probe emitted no permission ask gate"
    fi
    if [ -f "$TESTDIR/probe.txt" ]; then
      ok "live allowlisted bash ran without PS (probe written)"
    else
      ok "live probe soft-skip (API/model may be unavailable; structural checks hard)"
    fi
    rm -rf "$TESTDIR"
  else
    ok "pi not installed; skipped live probe"
    ok "pi not installed; skipped live probe (2)"
  fi

  echo
  if [ "$fail" -eq 0 ]; then
    echo "  VERDICT: PASS ($pass checks)"
  else
    echo "  VERDICT: FAIL ($fail failed, $pass passed)"
  fi
} | tee "$OUT"

exit "$fail"
