#!/usr/bin/env bash
# agy-researcher — Gemini long-context read/analysis via agy. --mode plan = read-only (no edits).
# agy has no tool allowlist, so read-only is enforced via plan mode + sandbox, not a fine allowlist.
set -euo pipefail
# YOLO: autonomous fleets set FLEET_YOLO=1 to auto-approve (no permission prompts).
# Default (unset) is safe/interactive. Read-only seats stay read-only either way.
YOLO=""; [ "${FLEET_YOLO:-}" = "1" ] && YOLO="--dangerously-skip-permissions"
exec agy $YOLO --mode plan --sandbox --model "Gemini 3.1 Pro (High)" "$@"
