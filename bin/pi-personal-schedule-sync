#!/usr/bin/env bash
# Install the personal-assistant's launchd schedules without touching pi's machine-global scheduler.
# Called by bin/pi-personal-assistant on every start/restart; safe to run manually for repair.
#
# Env overrides:
#   PI_SCHEDULE_SYNC_ENABLED=0      - unload and remove personal LaunchAgents
#   PI_FLEET_PROFILE                - when set, must be "personal-assistant"
#   PI_SCHEDULE_SYNC_AGENTS_DIR     - LaunchAgents dir (default: ~/Library/LaunchAgents)
#   PI_SCHEDULE_SYNC_LOG_DIR        - stdout/stderr dir (default: <runtime-root>/logs/personal)
#   PI_SCHEDULE_SYNC_LOG_MAX_BYTES  - rotate logs above this size (default: 5242880)
#   PI_FLEET_REPO_ROOT              - stable pi-fleet checkout (default: ~/code/pi-fleet)
#   PI_SCHEDULE_SYNC_DRY_RUN=1      - write/diff plists but do not call launchctl
#   PI_SCHEDULE_SYNC_SCHEDULES_JSON - schedules source (default: this repo)
#   PI_SCHEDULE_SYNC_RUNNER         - stable executable runner path
set -euo pipefail
umask 077

SELF_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=lib/runtime-state.sh
. "$SELF_ROOT/bin/lib/runtime-state.sh"
RUNTIME_ROOT="$(pi_fleet_runtime_root)"
PROFILE="${PI_FLEET_PROFILE:-}"
ENABLED="${PI_SCHEDULE_SYNC_ENABLED:-1}"
AGENTS_DIR="${PI_SCHEDULE_SYNC_AGENTS_DIR:-$HOME/Library/LaunchAgents}"
LOG_DIR="${PI_SCHEDULE_SYNC_LOG_DIR:-$RUNTIME_ROOT/logs/personal}"
case "$LOG_DIR" in "$RUNTIME_ROOT"|"$RUNTIME_ROOT"/*) LOG_BOUNDARY="$RUNTIME_ROOT" ;; *) LOG_BOUNDARY="$LOG_DIR" ;; esac
LOG_MAX_BYTES="${PI_SCHEDULE_SYNC_LOG_MAX_BYTES:-5242880}"
DRY_RUN="${PI_SCHEDULE_SYNC_DRY_RUN:-0}"
LABEL_PREFIX="dev.pi-fleet.personal"

if [[ -n "$PROFILE" && "$PROFILE" != "personal-assistant" ]]; then
  echo "pi-personal-schedule-sync: profile '$PROFILE' is not personal-assistant; skipping" >&2
  exit 0
fi

# A LaunchAgent must not capture a disposable feature-worktree path. Prefer the conventional,
# stable checkout used by pi-fleet-bootstrap; fall back to this checkout for other installations.
REPO_ROOT="${PI_FLEET_REPO_ROOT:-$HOME/code/pi-fleet}"
if [[ ! -x "$REPO_ROOT/bin/pi-personal-schedule-run" ]]; then
  REPO_ROOT="$SELF_ROOT"
fi
SCHEDULES_JSON="${PI_SCHEDULE_SYNC_SCHEDULES_JSON:-$REPO_ROOT/profiles/personal-assistant/schedules.json}"
RUNNER="${PI_SCHEDULE_SYNC_RUNNER:-$REPO_ROOT/bin/pi-personal-schedule-run}"

[[ "$LOG_MAX_BYTES" =~ ^[0-9]+$ ]] || { echo "PI_SCHEDULE_SYNC_LOG_MAX_BYTES must be an integer" >&2; exit 2; }
pi_fleet_assert_no_symlink_path "$AGENTS_DIR"
pi_fleet_assert_no_symlink_path "$LOG_DIR" "$LOG_BOUNDARY"
mkdir -p "$AGENTS_DIR" "$LOG_DIR"
pi_fleet_assert_no_symlink_path "$AGENTS_DIR"
pi_fleet_assert_no_symlink_path "$LOG_DIR" "$LOG_BOUNDARY"
chmod 700 "$LOG_DIR"
# launchd does not rotate StandardOutPath. Keep three private generations, bounded on every sync.
shopt -s nullglob
for log in "$LOG_DIR"/*.log; do
  pi_fleet_assert_no_symlink_path "$log" "$LOG_DIR"
  [[ -f "$log" && ! -L "$log" ]] || continue
  pi_fleet_assert_no_symlink_path "$log.1" "$LOG_DIR"
  pi_fleet_assert_no_symlink_path "$log.2" "$LOG_DIR"
  pi_fleet_assert_no_symlink_path "$log.3" "$LOG_DIR"
  size="$(stat -f '%z' "$log")"
  if (( size > LOG_MAX_BYTES )); then
    rm -f "$log.3"; [[ ! -e "$log.2" ]] || mv "$log.2" "$log.3"
    [[ ! -e "$log.1" ]] || mv "$log.1" "$log.2"
    mv "$log" "$log.1"; chmod 600 "$log.1"
  else
    chmod 600 "$log"
  fi
done
shopt -u nullglob

# Runtime enforcement: personal launchd schedules must never bleed into pi's global scheduler
# store. Other pi runtimes (e.g. remote-pi/dev.remotepi.supervisord) can still write to it from
# outside this repo, so every sync purges whatever is found there.
"$SELF_ROOT/bin/lib/scheduler-status.sh" || echo "pi-personal-schedule-sync: scheduler-status check failed, continuing" >&2

if [[ "$ENABLED" == "0" ]]; then
  shopt -s nullglob
  plists=("$AGENTS_DIR/$LABEL_PREFIX".*.plist)
  shopt -u nullglob
  # "${plists[@]}" on a zero-element array raises "unbound variable" under set -u on bash < 4.4
  # (stock /bin/bash on macOS is 3.2.57) - guard the count before expanding.
  if (( ${#plists[@]} > 0 )); then
    for plist_path in "${plists[@]}"; do
      label="$(basename "$plist_path" .plist)"
      echo "pi-personal-schedule-sync: disabling $label"
      if [[ "$DRY_RUN" != "1" ]]; then
        launchctl bootout "gui/$(id -u)/$label" >/dev/null 2>&1 || true
      fi
      rm -f "$plist_path"
    done
  fi
  exit 0
fi

if [[ ! -f "$SCHEDULES_JSON" ]]; then
  echo "pi-personal-schedule-sync: no schedules.json at $SCHEDULES_JSON" >&2
  exit 1
fi
if [[ ! -x "$RUNNER" ]]; then
  echo "pi-personal-schedule-sync: runner is missing or not executable: $RUNNER" >&2
  exit 1
fi
if ! command -v outfitter >/dev/null 2>&1; then
  echo "pi-personal-schedule-sync: outfitter is not available in PATH; refusing broken LaunchAgents" >&2
  exit 1
fi

python3 - "$SCHEDULES_JSON" "$AGENTS_DIR" "$LOG_DIR" "$RUNNER" "$LABEL_PREFIX" "$DRY_RUN" "$PATH" <<'PYEOF'
import json, os, plistlib, re, stat, subprocess, sys
from pathlib import Path

schedules_path, agents_dir, log_dir, runner, label_prefix, dry_run, launch_path = sys.argv[1:8]
def no_symlinks(raw, boundary_raw=None):
    target = Path(raw)
    boundary = Path(boundary_raw or raw)
    current = boundary
    for part in ("", *target.relative_to(boundary).parts):
        if part: current /= part
        try: mode = current.lstat().st_mode
        except FileNotFoundError: continue
        if stat.S_ISLNK(mode): raise RuntimeError(f"refusing symlink path: {current}")
no_symlinks(agents_dir); no_symlinks(log_dir)
dry_run = dry_run == "1"

with open(schedules_path) as f:
    data = json.load(f)

uid = os.getuid()
domain = f"gui/{uid}"

for sched in data.get("schedules", []):
    if not sched.get("enabled", True):
        continue
    name = sched["name"]
    if not isinstance(name, str) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,127}", name) or name in (".", ".."):
        print(f"pi-personal-schedule-sync: unsafe schedule name: {name!r}", file=sys.stderr)
        sys.exit(1)
    cron_fields = sched["cron"].split()
    if len(cron_fields) != 6:
        print(f"pi-personal-schedule-sync: {name}: cron must be 6 fields (sec min hour dom month dow), got {sched['cron']!r}", file=sys.stderr)
        sys.exit(1)
    sec, minute, hour, dom, month, dow = cron_fields
    if sec != "0" or dom != "*" or month != "*" or dow != "*":
        print(f"pi-personal-schedule-sync: {name}: only second 0 and '* * *' (dom/month/dow) schedules are supported", file=sys.stderr)
        sys.exit(1)
    try:
        minute_value = int(minute)
        hour_value = None if hour == "*" else int(hour)
    except ValueError:
        print(f"pi-personal-schedule-sync: {name}: minute/hour must be integers or supported wildcards", file=sys.stderr)
        sys.exit(1)
    if not 0 <= minute_value <= 59 or (hour_value is not None and not 0 <= hour_value <= 23):
        print(f"pi-personal-schedule-sync: {name}: minute/hour is out of range", file=sys.stderr)
        sys.exit(1)

    calendar_interval = {"Minute": minute_value}
    if hour_value is not None:
        calendar_interval["Hour"] = hour_value

    label = f"{label_prefix}.{name}"
    plist_path = os.path.join(agents_dir, f"{label}.plist")
    stdout_path = os.path.join(log_dir, f"{name}.log")
    stderr_path = os.path.join(log_dir, f"{name}.error.log")
    no_symlinks(plist_path, agents_dir); no_symlinks(stdout_path, log_dir); no_symlinks(stderr_path, log_dir)
    desired = {
        "Label": label,
        "ProgramArguments": [runner, name],
        # launchd does not inherit the interactive shell PATH. The runner ultimately execs
        # outfitter, so preserve the validated PATH from sync time.
        "EnvironmentVariables": {"PATH": launch_path},
        "StartCalendarInterval": calendar_interval,
        "StandardOutPath": stdout_path,
        "StandardErrorPath": stderr_path,
        "RunAtLoad": False,
        "PiFleetCronOriginal": sched["cron"],
        "PiFleetTaskId": sched.get("taskId", ""),
    }
    desired_bytes = plistlib.dumps(desired, sort_keys=True)

    existing_normalized = None
    if os.path.exists(plist_path):
        try:
            with open(plist_path, "rb") as f:
                existing_normalized = plistlib.dumps(plistlib.load(f), sort_keys=True)
        except Exception:
            pass

    if existing_normalized == desired_bytes:
        print(f"pi-personal-schedule-sync: {name}: already up to date ({plist_path})")
    else:
        action = "updating" if os.path.exists(plist_path) else "creating"
        print(f"pi-personal-schedule-sync: {name}: {action} {plist_path}")
        tmp_path = f"{plist_path}.tmp.{os.getpid()}"
        no_symlinks(tmp_path, agents_dir)
        with open(tmp_path, "xb") as f:
            f.write(desired_bytes)
        os.replace(tmp_path, plist_path)

    if dry_run:
        print(f"pi-personal-schedule-sync: {name}: DRY_RUN=1, skipping launchctl reload")
        continue

    # Always reload, even when bytes are unchanged: the installed job may be unloaded or may have
    # failed with status 127 under an earlier environment.
    subprocess.run(["launchctl", "bootout", f"{domain}/{label}"], capture_output=True)
    result = subprocess.run(["launchctl", "bootstrap", domain, plist_path], capture_output=True, text=True)
    if result.returncode != 0:
        print(f"pi-personal-schedule-sync: {name}: launchctl bootstrap failed: {result.stderr.strip()}", file=sys.stderr)
        sys.exit(1)
    print(f"pi-personal-schedule-sync: {name}: launchd job loaded")
PYEOF
