#!/usr/bin/env bash
# claude-reviewer — independent READ-ONLY review on the Claude harness (different harness than the
# pi/agy worker that built the code). Hard read-only: mutating tools disallowed.
set -euo pipefail
DIR="$HOME/code/pi-fleet"
# YOLO: autonomous fleets set FLEET_YOLO=1 to auto-approve (no permission prompts).
# Default (unset) is safe/interactive. Read-only seats stay read-only either way.
YOLO=""; [ "${FLEET_YOLO:-}" = "1" ] && YOLO="--dangerously-skip-permissions"
exec claude $YOLO \
  --allowedTools "Read Grep Glob" \
  --disallowedTools "Bash Edit Write MultiEdit NotebookEdit WebFetch" \
  --append-system-prompt "$(cat "$DIR/skills/claude-reviewer/PROMPT.md")" \
  "$@"
