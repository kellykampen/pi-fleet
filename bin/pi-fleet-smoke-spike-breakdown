#!/usr/bin/env bash
# pi-fleet-smoke-spike-breakdown — static shape check for the spike-breakdown seat.
# No pi, no auth, no Linear writes: it only asserts the profile/wrapper/skill/agent files are wired
# the way the other seats are, and that the wrapper's --tools allowlist keeps the intended boundary
# (bash + linear read, but NO write/edit — spike-breakdown writes to Linear, never to repo source).
# Exit non-zero on the first failed assertion so CI can gate on it.
set -uo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
fail=0
ok(){ printf "  ok   %s\n" "$1"; }
no(){ printf "  FAIL %s\n" "$1"; fail=1; }
has(){ grep -q -- "$2" "$1"; }

echo "spike-breakdown smoke ($ROOT)"

PROFILE="$ROOT/profiles/spike-breakdown/profile.yml"
WRAPPER="$ROOT/bin/pi-spike-breakdown"
SKILL="$ROOT/skills/spike-breakdown/SKILL.md"
AGENT="$ROOT/agents/spike-breakdown.md"
INTERVIEW_WRAPPER="$ROOT/bin/pi-fleet-spike-interview"
INTERVIEW_PACKAGE="$ROOT/tools/agent-interview-cli/package.json"
INTERVIEW_LOCK="$ROOT/tools/agent-interview-cli/package-lock.json"
INTERVIEW_DOC="$ROOT/docs/spike-interviews.md"

# 1. Profile exists, has the right id, skills, and linear extension.
if [ -f "$PROFILE" ]; then ok "profile.yml exists"; else no "profile.yml missing"; fi
has "$PROFILE" 'id: spike-breakdown'        && ok "profile id"            || no "profile id"
has "$PROFILE" '../skills/spike-breakdown'  && ok "spike-breakdown skill" || no "spike-breakdown skill"
has "$PROFILE" '../skills/issue-breakdown'  && ok "issue-breakdown skill" || no "issue-breakdown skill"
has "$PROFILE" '../extensions/linear.ts'    && ok "linear extension"      || no "linear extension"
python3 -c "import sys,yaml; yaml.safe_load(open('$PROFILE'))" 2>/dev/null \
  && ok "profile is valid YAML" || no "profile is NOT valid YAML"

# 2. Wrapper exists, executable, targets the profile, and keeps the tool boundary.
if [ -x "$WRAPPER" ]; then ok "wrapper is executable"; else no "wrapper missing/not executable"; fi
has "$WRAPPER" -- '--profile spike-breakdown' && ok "wrapper targets profile" || no "wrapper targets profile"
has "$WRAPPER" -- 'bash'                       && ok "wrapper has bash (linear-cli)" || no "wrapper missing bash"
has "$WRAPPER" -- 'linear_get_issue'           && ok "wrapper has linear read" || no "wrapper missing linear read"
has "$WRAPPER" 'PATH="$DIR:$PATH"'              && ok "fleet interview helper is on PATH" || no "fleet interview helper missing from PATH"
TOOLS_LINE="$(grep -oE -- '--tools [^\"]+' "$WRAPPER" || true)"
case "$TOOLS_LINE" in
  *,write,*|*,write|*write,*) no "wrapper allowlist leaks write" ;;
  *) ok "wrapper allowlist has no write" ;;
esac
case "$TOOLS_LINE" in
  *,edit,*|*,edit|*edit,*) no "wrapper allowlist leaks edit" ;;
  *) ok "wrapper allowlist has no edit" ;;
esac

# 3. Skill + subagent roster entry exist and name themselves correctly.
has "$SKILL" 'name: spike-breakdown' && ok "skill front-matter name" || no "skill front-matter name"
has "$AGENT" 'name: spike-breakdown' && ok "agent front-matter name" || no "agent front-matter name"

# 4. The behavioral contract the AC cares about is documented somewhere in the seat's text.
CONTRACT="$PROFILE $SKILL $AGENT"
grep -qiE 'Spike'                  $CONTRACT && ok "spike label filtering documented"       || no "spike label filtering documented"
grep -qi  'agent-interview-cli'    $CONTRACT && ok "browser interview CLI documented"       || no "browser interview CLI missing"
grep -qi  'direct browser'         $CONTRACT && ok "direct browser is primary"               || no "direct browser primary missing"
if grep -qiE 'claude-conductor|AskUserQuestion|interview-linear' $CONTRACT; then
  no "retired conductor/AskUserQuestion/interview-linear relay remains"
else
  ok "retired relay mechanisms absent"
fi
grep -qiE 'stable (question |decision )?IDs?' $CONTRACT && ok "stable decision IDs documented" || no "stable decision IDs missing"
grep -qiE 'critical.*minor|minor.*critical' $CONTRACT && ok "decision weights documented"      || no "decision weights missing"
grep -qi  'conviction'             $CONTRACT && ok "decision conviction documented"          || no "decision conviction missing"
grep -qiE 'before (any )?decompos|before draft' $CONTRACT && ok "audit-before-decomposition gate" || no "audit-before-decomposition gate missing"
grep -qiE 'cancelled.*timeout|timeout.*cancelled' $CONTRACT && ok "cancel/timeout behavior documented" || no "cancel/timeout behavior missing"
grep -qE  '3 ?pt|<=3|≤3'           $CONTRACT && ok "<=3-point rule documented"              || no "<=3-point rule documented"
grep -q   -- '- \[ \]'             $CONTRACT && ok "checkbox AC documented"                 || no "checkbox AC documented"
grep -qi  'blocker'                $CONTRACT && ok "blockers/dependencies documented"       || no "blockers/dependencies documented"

# 5. The CLI is repo-local, exact-version pinned, and routed through the audit wrapper.
if [ -x "$INTERVIEW_WRAPPER" ]; then ok "interview audit wrapper is executable"; else no "interview audit wrapper missing/not executable"; fi
has "$SKILL" 'pi-fleet-spike-interview run' && ok "skill invokes fleet interview wrapper" || no "skill does not invoke fleet interview wrapper"
node -e '
  const fs = require("fs");
  try {
    const pkg = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
    const lock = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
    if (pkg.dependencies?.["agent-interview-cli"] !== "0.1.0") process.exit(1);
    const pinned = lock.packages?.["node_modules/agent-interview-cli"];
    if (pinned?.version !== "0.1.0" || !pinned.integrity) process.exit(1);
  } catch (error) {
    console.error(error.message);
    process.exit(1);
  }
' "$INTERVIEW_PACKAGE" "$INTERVIEW_LOCK" 2>/dev/null \
  && ok "agent-interview-cli 0.1.0 exact pin + integrity lock" \
  || no "agent-interview-cli pin/lock invalid"
[ -f "$INTERVIEW_DOC" ] && ok "spike interview audit/install doc exists" || no "spike interview audit/install doc missing"

# 6. If outfitter is on PATH, confirm it can load the profile (best-effort; skipped otherwise).
if command -v outfitter >/dev/null 2>&1; then
  if outfitter profile list 2>/dev/null | grep -q spike-breakdown; then
    ok "outfitter lists the profile"
  else
    echo "  note outfitter present but profile not listed (profile_sources may point elsewhere) — skipping"
  fi
else
  echo "  note outfitter not on PATH — skipping live profile-list check"
fi

echo
if [ "$fail" = 0 ]; then echo "VERDICT: PASS"; else echo "VERDICT: FAIL"; fi
exit "$fail"
