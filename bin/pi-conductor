#!/usr/bin/env bash
# Conductor is a portfolio router only (FLT-65): talk to project leads + CEO via cmux/Linear.
# No product-repo investigation tools (read/grep/find), no write/edit, no product PR-diff review.
# Bash remains for cmux, Linear CLI, portfolio metadata (gh pr list/checks, git status/log/branch),
# and fleet-note — the immutable conductor-policy extension denies git diff/show, gh pr view,
# gh api, and content readers that enable in-repo investigation.
set -euo pipefail
FLEET_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# Runtime evidence: personal launchd schedules must never bleed into pi's global scheduler store.
"$FLEET_ROOT/bin/lib/scheduler-status.sh" || echo "pi-conductor: scheduler-status check failed, continuing" >&2
. "$FLEET_ROOT/bin/lib/pi-model-env.sh"
. "$FLEET_ROOT/bin/lib/pi-conductor-runtime.sh"
pi_model_override_args conductor "" "$@"
YOLO=""
[ "${FLEET_YOLO:-}" = "1" ] && YOLO="--approve"

# Resolve the package before switching Pi to the isolated conductor agent/config overlay. The
# dedicated policy cwd prevents a caller repo's project config from weakening conductor.json.
pi_conductor_prepare_runtime "$FLEET_ROOT"

# FLT-35: --no-extensions blocks machine-global package auto-discovery. Explicit extensions remain:
# Linear orchestration, pi-permission-system, conductor-policy, then pi-xai-oauth (xai-auth) when installed.
. "$FLEET_ROOT/bin/lib/pi-xai-oauth-ext.sh"
exec outfitter run --profile conductor --agent pi -- "${PI_MODEL_ARGS[@]+"${PI_MODEL_ARGS[@]}"}" $YOLO \
  --no-extensions \
  --extension "$FLEET_ROOT/extensions/linear.ts" \
  --extension "$PI_PERMISSION_SYSTEM_PATH" \
  --extension "$FLEET_ROOT/extensions/conductor-policy.ts" \
  ${PI_XAI_OAUTH_EXT_ARGS[@]+"${PI_XAI_OAUTH_EXT_ARGS[@]}"} \
  --tools bash,linear_get_issue,linear_list,linear_comment,linear_update "$@"
