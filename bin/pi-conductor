#!/usr/bin/env bash
# Conductor coordinates project leads — same tool surface as project-lead (Linear + bash for casting
# panes/wrappers), but the skill forbids implementing or casting workers directly.
set -euo pipefail
FLEET_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# Runtime evidence: personal launchd schedules must never bleed into pi's global scheduler store.
"$FLEET_ROOT/bin/lib/scheduler-status.sh" || echo "pi-conductor: scheduler-status check failed, continuing" >&2
. "$FLEET_ROOT/bin/lib/pi-model-env.sh"
pi_model_override_args conductor "" "$@"
YOLO=""
[ "${FLEET_YOLO:-}" = "1" ] && YOLO="--approve"
# FLT-35: --no-extensions blocks machine-global package auto-discovery (e.g. @jl1990/pi-scheduler);
# the explicit --extension flag below is unaffected and still loads.
exec outfitter run --profile conductor --agent pi -- "${PI_MODEL_ARGS[@]+"${PI_MODEL_ARGS[@]}"}" $YOLO \
  --no-extensions \
  --extension "$FLEET_ROOT/extensions/linear.ts" \
  --tools read,grep,find,ls,write,edit,bash,linear_get_issue,linear_list,linear_comment,linear_update "$@"
