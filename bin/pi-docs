#!/usr/bin/env bash
# Hybrid: outfitter composes skill/extension/model/prompt; this wrapper hardcodes --tools (the
# boundary). write/edit for updating docs; bash for git/gh (reading the PR diff) - not a general
# implementation seat, the docs skill itself constrains scope to documentation.
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$DIR/lib/pi-model-env.sh"
PI_MODEL_ARGS="$(pi_model_override_args docs "" "$@")"
# shellcheck disable=SC2086
exec outfitter run --profile docs --agent pi -- $PI_MODEL_ARGS --tools read,grep,find,ls,write,edit,bash,linear_get_issue,linear_list,linear_comment "$@"
