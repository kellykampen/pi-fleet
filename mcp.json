{
  "mcpServers": {
    "context7": {
      "transport": "streamable-http",
      "url": "https://mcp.context7.com/mcp",
      "lifecycle": "eager"
    },
    "playwright": {
      "transport": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ],
      "lifecycle": "lazy"
    },
    "convex": {
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "convex@latest",
        "mcp",
        "start"
      ],
      "lifecycle": "lazy"
    },
    "claude_design": {
      "transport": "streamable-http",
      "url": "https://api.anthropic.com/v1/design/mcp",
      "lifecycle": "lazy",
      "auth": "oauth",
      "oauth": {
        "grantType": "authorization_code",
        "scope": "user:design:read user:design:write"
      }
    }
  }
}
