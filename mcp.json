{
  "mcpServers": {
    "context7":   { "transport": "streamable-http", "url": "https://mcp.context7.com/mcp", "lifecycle": "eager" },
    "playwright": { "transport": "stdio", "command": "npx", "args": ["@playwright/mcp@latest"], "lifecycle": "eager" },
    "convex":     { "transport": "stdio", "command": "npx", "args": ["-y", "convex@latest", "mcp", "start"], "lifecycle": "eager" }
  }
}
